# CEO Panel - Production Environment Template
# این فایل را کپی کن به .env و مقادیر واقعی را پر کن
# هرگز .env را به Git نفرست!

# Server
PORT=3000
NODE_ENV=production
ALLOWED_DOMAIN=https://panel.yourstore.ir

# Security - JWT (یک رشته تصادفی 32+ کاراکتر بساز)
JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_CHARS_MIN
ENCRYPTION_KEY=CHANGE_THIS_TO_32_BYTES_HEX_64_CHARS

# Auth - OTP
ALLOWED_PHONE=09017909857
OTP_EXPIRES_SECONDS=300
OTP_RATE_LIMIT_PER_MINUTE=3
OTP_MAX_ATTEMPTS=5

# ================= CENTRAL CONTROL PLANE =================
# Integration credentials are now managed via DB (Integrations Hub) — ENV only for infra (DATABASE_URL, JWT_SECRET, ENCRYPTION_KEY).
# The following ENV entries are LEGACY — prefer UI configuration at /api/integrations/hub
# =========================================================

# Basalam - از developers.basalam.com/panel بگیر
BASALAM_TOKEN=
BASALAM_STORE_URL=https://basalam.com/

# Telegram - از @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=CHANGE_THIS_RANDOM
TELEGRAM_WEBHOOK_URL=https://panel.yourstore.ir/api/integrations/telegram/webhook

# Instagram - از developers.facebook.com (Official API only)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_TOKEN_EXPIRES_AT=2026-12-31T00:00:00.000Z
INSTAGRAM_REDIRECT_URI=https://panel.yourstore.ir/api/integrations/instagram/callback
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=CHANGE_THIS_RANDOM
INSTAGRAM_ACCOUNT=

# SMS - Kavenegar (اختیاری - اگر خالی باشد OTP فقط در لاگ سرور)
KAVENEGAR_API_KEY=

# Webhook Security
BASALAM_WEBHOOK_SECRET=CHANGE_THIS_RANDOM
DATABASE_URL=postgresql://user:pass@localhost:5432/db
