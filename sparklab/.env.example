# Spark Lab — نمونه تنظیمات محیطی
# این فایل را به .env کپی کنید و مقادیر را پر کنید. هرگز .env را در Git قرار ندهید.

PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# نشانی عمومی سایت (برای ساخت callback درگاه) — بدون اسلش انتهایی
PUBLIC_URL=https://example.com

# امنیت — رشته‌های تصادسی بلند بسازید (openssl rand -hex 48)
SESSION_SECRET=
# ۶۴ کاراکتر هگز (۳۲ بایت) برای رمزنگاری اطلاعات محرمانه درگاه در پایگاه داده
ENCRYPTION_KEY=

# حساب مدیر اولیه (فقط در اولین seed استفاده می‌شود)
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=مدیر سایت

# درگاه پرداخت زرین‌پال (می‌توانید از پنل مدیریت هم وارد کنید؛ ذخیره در DB رمزنگاری می‌شود)
ZARINPAL_MERCHANT_ID=

# ایمیل (SMTP) — برای بازیابی رمز عبور و اطلاع‌رسانی سفارش
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Spark Lab <noreply@yourdomain.com>"

# محدودیت حجم بارگذاری (مگابایت)
UPLOAD_IMAGE_MB=5
UPLOAD_PRODUCT_FILE_MB=300
UPLOAD_ATTACHMENT_MB=10

# مسیرهای داده (اختیاری — پیش‌فرض داخل پوشه پروژه)
# DATA_DIR=/var/lib/sparklab/data
# STORAGE_DIR=/var/lib/sparklab/storage
