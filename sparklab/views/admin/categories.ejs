<%- include('../partials/head') %>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-side') %>
  <div class="admin-main">
    <%- include('../partials/admin-top') %>
    <%- include('../partials/flash') %>
    <div class="admin-content">
      <div class="grid grid-2 mb-3" style="grid-template-columns:380px 1fr;align-items:start">
        <div class="card">
          <h2 class="h3 mb-3">دسته‌بندی جدید</h2>
          <form method="POST" action="/admin/categories/new">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group">
              <label class="form-label">نام <span class="req">*</span></label>
              <input class="input <%= errors.name ? 'invalid' : '' %>" name="name" value="<%= values.name || '' %>" required>
              <% if (errors.name) { %><span class="form-error"><%= errors.name %></span><% } %>
            </div>
            <div class="form-group">
              <label class="form-label">نشانی (slug)</label>
              <input class="input <%= errors.slug ? 'invalid' : '' %>" name="slug" dir="ltr" style="text-align:left" value="<%= values.slug || '' %>" placeholder="auto">
              <% if (errors.slug) { %><span class="form-error"><%= errors.slug %></span><% } %>
            </div>
            <div class="form-group">
              <label class="form-label">توضیحات</label>
              <textarea class="textarea" name="description" style="min-height:70px"><%= values.description || '' %></textarea>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">آیکون</label>
                <select class="select" name="icon">
                  <% ['chart','palette','phone','spark','flow'].forEach(function (ic) { %>
                    <option value="<%= ic %>"><%= ic %></option>
                  <% }); %>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">ترتیب</label>
                <input class="input" name="sort_order" type="number" min="0" value="0">
              </div>
            </div>
            <button class="btn btn-primary btn-block" type="submit">افزودن دسته‌بندی</button>
          </form>
        </div>
        <div class="table-wrap">
          <table class="tbl">
            <thead><tr><th>نام</th><th>نشانی</th><th>محصولات</th><th>ترتیب</th><th>وضعیت</th><th></th></tr></thead>
            <tbody>
              <% categories.forEach(function (c) { %>
                <tr>
                  <td>
                    <form method="POST" action="/admin/categories/<%= c.id %>/edit" class="flex" style="gap:.5rem">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input class="input" name="name" value="<%= c.name %>" style="padding:.3rem .6rem;font-size:.85rem;width:160px">
                      <input type="hidden" name="description" value="<%= c.description || '' %>">
                      <input type="hidden" name="icon" value="<%= c.icon || '' %>">
                      <input class="input" name="sort_order" type="number" value="<%= c.sort_order %>" style="padding:.3rem .6rem;font-size:.85rem;width:70px">
                      <input type="hidden" name="is_active" value="<%= c.is_active ? "1" : "" %>">
                      <button class="btn btn-ghost btn-sm" type="submit">ذخیره</button>
                    </form>
                  </td>
                  <td class="tiny" style="direction:ltr;text-align:right"><%= c.slug %></td>
                  <td class="num"><%= h.fmtMoney(c.product_count) %></td>
                  <td class="num"><%= h.fmtMoney(c.sort_order) %></td>
                  <td><span class="status <%= c.is_active ? 'ok' : 'muted' %>"><%= c.is_active ? 'فعال' : 'غیرفعال' %></span></td>
                  <td>
                    <form method="POST" action="/admin/categories/<%= c.id %>/delete" data-confirm="حذف دسته‌بندی «<%= c.name %>»؟ اگر محصول داشته باشد فقط غیرفعال می‌شود.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-danger btn-sm" type="submit">حذف</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<script nonce="<%= cspNonce %>">window.SPARK_CSRF = <%- JSON.stringify(csrfToken) %>;</script>
<script src="/js/admin.js" defer></script>
</body>
</html>
