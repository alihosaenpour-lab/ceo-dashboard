<%- include('../partials/head') %>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-side') %>
  <div class="admin-main">
    <%- include('../partials/admin-top') %>
    <%- include('../partials/flash') %>
    <div class="admin-content">
      <div class="panel-title">
        <form method="GET" action="/admin/products" class="search-inline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input class="input" type="search" name="q" value="<%= q %>" placeholder="جست‌وجوی محصول…">
        </form>
        <a class="btn btn-primary btn-sm" href="/admin/products/new">+ محصول جدید</a>
      </div>
      <div class="table-wrap">
        <table class="tbl">
          <thead><tr><th>محصول</th><th>دسته</th><th>قیمت</th><th>نسخه</th><th>فایل</th><th>فروش</th><th>وضعیت</th><th>عملیات</th></tr></thead>
          <tbody>
            <% products.forEach(function (p) { %>
              <tr>
                <td>
                  <div class="flex" style="gap:.7rem">
                    <img src="<%= p.cover_image || '/img/products/pos-dashboard.svg' %>" alt="" style="width:56px;height:42px;border-radius:8px;object-fit:cover;border:1px solid var(--border)">
                    <div>
                      <a href="/admin/products/<%= p.id %>/edit" style="font-weight:700"><%= p.title %></a>
                      <div class="tiny faint" style="direction:ltr;text-align:right">/product/<%= p.slug %></div>
                    </div>
                  </div>
                </td>
                <td class="small"><%= p.category_name || '—' %><% if (p.is_featured) { %> <span class="pill pill-hot">ویژه</span><% } %></td>
                <td class="num small"><%= h.fmtMoney(p.discount_price && p.discount_price < p.price ? p.discount_price : p.price) %> <% if (p.discount_price && p.discount_price < p.price) { %><br><s class="tiny faint"><%= h.fmtMoney(p.price) %></s><% } %></td>
                <td class="num small" style="direction:ltr"><%= p.version %></td>
                <td><% if (p.file_count > 0) { %><span class="status ok"><%= h.fmtMoney(p.file_count) %> فایل</span><% } else { %><span class="status bad">بدون فایل</span><% } %></td>
                <td class="num small"><%= h.fmtMoney(p.sales_count) %></td>
                <td>
                  <form method="POST" action="/admin/products/<%= p.id %>/toggle">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="status <%= p.is_active ? 'ok' : 'muted' %>" style="border:0;cursor:pointer;font-family:inherit" title="کلیک برای تغییر"><%= p.is_active ? 'فعال' : 'غیرفعال' %></button>
                  </form>
                </td>
                <td>
                  <div class="flex" style="gap:.35rem">
                    <a class="btn btn-ghost btn-sm" href="/admin/products/<%= p.id %>/edit">ویرایش</a>
                    <a class="btn btn-ghost btn-sm" href="/product/<%= p.slug %>" target="_blank" title="مشاهده در سایت">↗</a>
                    <form method="POST" action="/admin/products/<%= p.id %>/delete" data-confirm="حذف محصول «<%= p.title %>»؟ محصولات دارای سابقه فروش فقط غیرفعال می‌شوند.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-danger btn-sm" type="submit">حذف</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
            <% if (!products.length) { %><tr><td colspan="8" class="small muted text-center" style="padding:2rem">محصولی یافت نشد — <a href="/admin/products/new">اولین محصول را اضافه کنید</a>.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<script nonce="<%= cspNonce %>">window.SPARK_CSRF = <%- JSON.stringify(csrfToken) %>;</script>
<script src="/js/admin.js" defer></script>
</body>
</html>
