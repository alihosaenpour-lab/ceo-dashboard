<%- include('../partials/head') %>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-side') %>
  <div class="admin-main">
    <%- include('../partials/admin-top') %>
    <%- include('../partials/flash') %>
    <div class="admin-content">
      <form method="POST" action="/admin/content/portfolio/<%= item.id %>/edit?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid grid-2" style="grid-template-columns:1fr 320px;align-items:start">
          <div>
            <div class="card mb-3">
              <div class="form-group">
                <label class="form-label">عنوان <span class="req">*</span></label>
                <input class="input <%= errors.title ? 'invalid' : '' %>" name="title" value="<%= values.title || '' %>" required>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">نام کارفرما</label>
                  <input class="input" name="client_label" value="<%= values.client_label || '' %>">
                </div>
                <div class="form-group">
                  <label class="form-label">نشانی پروژه (URL)</label>
                  <input class="input" name="url" dir="ltr" style="text-align:left" value="<%= values.url || '' %>">
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">خلاصه</label>
                <textarea class="textarea" name="summary" style="min-height:70px"><%= values.summary || '' %></textarea>
              </div>
              <div class="form-group">
                <label class="form-label">مسئله (چالش مشتری)</label>
                <textarea class="textarea" name="problem_text" style="min-height:110px"><%= values.problem_text || '' %></textarea>
              </div>
              <div class="form-group">
                <label class="form-label">راه‌حل (چه ساختیم)</label>
                <textarea class="textarea" name="solution_text" style="min-height:110px"><%= values.solution_text || '' %></textarea>
              </div>
              <div class="form-group">
                <label class="form-label">دستاورد / نتیجه</label>
                <input class="input" name="result_metric" value="<%= values.result_metric || '' %>" placeholder="مثلاً: ۳ برابر شدن فروش در ۶ ماه">
              </div>
            </div>
            <div class="card">
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">امکانات (هر مورد یک خط)</label>
                  <textarea class="textarea" name="features" style="min-height:140px"><%= (item.features || []).join('\n') %></textarea>
                </div>
                <div class="form-group">
                  <label class="form-label">فناوری‌ها (هر مورد یک خط)</label>
                  <textarea class="textarea" name="tech" style="min-height:140px"><%= (item.tech || []).join('\n') %></textarea>
                </div>
              </div>
            </div>
          </div>
          <aside class="card">
            <button class="btn btn-primary btn-block btn-lg" type="submit">ذخیره</button>
            <a class="btn btn-ghost btn-block mt-2" href="/portfolio/<%= item.slug %>" target="_blank">مشاهده در سایت ↗</a>
            <hr class="divider">
            <% if (item.cover_image) { %><img src="<%= item.cover_image %>" alt="" style="border-radius:12px;border:1px solid var(--border)" class="mb-2"><% } %>
            <div class="file-drop">
              <input type="file" name="cover" accept=".jpg,.jpeg,.png,.webp,.svg">
              <span class="form-hint">تصویر کاور جدید (جایگزین می‌شود)</span>
            </div>
            <div class="form-group mt-2">
              <label class="form-label">ترتیب نمایش</label>
              <input class="input" name="sort_order" type="number" value="<%= item.sort_order %>">
            </div>
            <div class="check-row">
              <input type="checkbox" id="ck-a" name="is_active" value="1" <%= item.is_active ? 'checked' : '' %>>
              <label for="ck-a">منتشر شده</label>
            </div>
          </aside>
        </div>
      </form>
    </div>
  </div>
</div>
<script nonce="<%= cspNonce %>">window.SPARK_CSRF = <%- JSON.stringify(csrfToken) %>;</script>
<script src="/js/admin.js" defer></script>
</body>
</html>
