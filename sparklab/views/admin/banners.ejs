<%- include('../partials/head') %>
<body class="admin-body">
<div class="admin-shell">
  <%- include('../partials/admin-side') %>
  <div class="admin-main">
    <%- include('../partials/admin-top') %>
    <%- include('../partials/flash') %>
    <div class="admin-content">
      <div class="panel-title"><h1>بنرهای صفحه اصلی</h1></div>
      <div class="card mb-3">
        <h2 class="h3 mb-3">بنر جدید</h2>
        <form method="POST" action="/admin/content/banners/new?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="grid grid-3" style="align-items:end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group" style="margin:0">
            <label class="form-label">عنوان <span class="req">*</span></label>
            <input class="input" name="title" required>
          </div>
          <div class="form-group" style="margin:0">
            <label class="form-label">زیرعنوان</label>
            <input class="input" name="subtitle">
          </div>
          <div class="form-group" style="margin:0">
            <label class="form-label">متن دکمه</label>
            <input class="input" name="cta_text">
          </div>
          <div class="form-group" style="margin:0">
            <label class="form-label">لینک دکمه</label>
            <input class="input" name="cta_url" dir="ltr" style="text-align:left" placeholder="/shop">
          </div>
          <div class="form-group" style="margin:0">
            <label class="form-label">تصویر (اختیاری)</label>
            <div class="file-drop"><input type="file" name="image" accept=".jpg,.jpeg,.png,.webp,.svg"></div>
          </div>
          <div class="flex" style="gap:1rem;align-items:center">
            <label class="check-row"><input type="checkbox" name="is_active" value="1" checked> فعال</label>
            <input class="input" name="sort_order" type="number" value="0" style="width:80px" title="ترتیب">
            <button class="btn btn-primary" type="submit">افزودن بنر</button>
          </div>
        </form>
      </div>
      <% banners.forEach(function (b) { %>
        <div class="card mb-2">
          <form method="POST" action="/admin/content/banners/<%= b.id %>/edit?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="grid grid-3" style="align-items:end">
              <div class="form-group" style="margin:0">
                <label class="form-label tiny">عنوان</label>
                <input class="input" name="title" value="<%= b.title %>">
              </div>
              <div class="form-group" style="margin:0">
                <label class="form-label tiny">زیرعنوان</label>
                <input class="input" name="subtitle" value="<%= b.subtitle || '' %>">
              </div>
              <div class="form-group" style="margin:0">
                <label class="form-label tiny">متن دکمه</label>
                <input class="input" name="cta_text" value="<%= b.cta_text || '' %>">
              </div>
              <div class="form-group" style="margin:0">
                <label class="form-label tiny">لینک</label>
                <input class="input" name="cta_url" value="<%= b.cta_url || '' %>" dir="ltr" style="text-align:left">
              </div>
              <div class="form-group" style="margin:0">
                <label class="form-label tiny">تصویر جدید</label>
                <div class="file-drop"><input type="file" name="image" accept=".jpg,.jpeg,.png,.webp,.svg"></div>
              </div>
              <div class="flex" style="gap:.8rem;align-items:center">
                <label class="check-row"><input type="checkbox" name="is_active" value="1" <%= b.is_active ? 'checked' : '' %>> فعال</label>
                <input class="input" name="sort_order" type="number" value="<%= b.sort_order %>" style="width:70px">
                <button class="btn btn-primary btn-sm" type="submit">ذخیره</button>
              </div>
            </div>
          </form>
          <div class="flex-between mt-2">
            <span class="tiny faint">ساخته‌شده: <%= h.fmtDate(b.created_at) %><% if (b.image) { %> · تصویر: <span style="direction:ltr"><%= b.image %></span><% } %></span>
            <form method="POST" action="/admin/content/banners/<%= b.id %>/delete" data-confirm="حذف این بنر؟">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-danger btn-sm" type="submit">حذف</button>
            </form>
          </div>
        </div>
      <% }); %>
      <% if (!banners.length) { %><p class="small muted">بنری ثبت نشده است.</p><% } %>
    </div>
  </div>
</div>
<script nonce="<%= cspNonce %>">window.SPARK_CSRF = <%- JSON.stringify(csrfToken) %>;</script>
<script src="/js/admin.js" defer></script>
</body>
</html>
