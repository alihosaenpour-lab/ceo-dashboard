<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="page-hero">
  <div class="container">
    <nav class="breadcrumbs"><a href="/">خانه</a><span class="sep">/</span><span>تماس با ما</span></nav>
    <h1>تماس با ما</h1>
    <p>سؤال، پیشنهاد همکاری یا نیاز به مشاوره دارید؟ از هر مسیر زیر در ارتباط باشید.</p>
  </div>
</div>

<section class="section-tight" style="padding-bottom:4rem">
  <div class="container">
    <div class="grid-contact">
      <div>
        <div class="card mb-2">
          <div class="footer-contact">
            <% if (settings.phone) { %>
            <div class="fc-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span><b>تلفن:</b> <span style="direction:ltr;display:inline-block"><%= settings.phone %></span></span>
            </div>
            <% } %>
            <% if (settings.email) { %>
            <div class="fc-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span><b>ایمیل:</b> <%= settings.email %></span>
            </div>
            <% } %>
            <% if (settings.address) { %>
            <div class="fc-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
              <span><b>آدرس:</b> <%= settings.address %></span>
            </div>
            <% } %>
            <% if (settings.workhours) { %>
            <div class="fc-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span><b>ساعات کاری:</b> <%= settings.workhours %></span>
            </div>
            <% } %>
          </div>
        </div>
        <div class="card">
          <h4 class="small" style="color:var(--cyan)">شبکه‌های اجتماعی</h4>
          <div class="social-row mt-2">
            <% if (settings.socials.instagram) { %><a href="<%= settings.socials.instagram %>" rel="noopener" target="_blank" aria-label="اینستاگرام"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg></a><% } %>
            <% if (settings.socials.telegram) { %><a href="<%= settings.socials.telegram %>" rel="noopener" target="_blank" aria-label="تلگرام"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg></a><% } %>
            <% if (settings.socials.linkedin) { %><a href="<%= settings.socials.linkedin %>" rel="noopener" target="_blank" aria-label="لینکدین"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-13h4v2a6 6 0 0 1 2-2z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg></a><% } %>
            <% if (settings.socials.github) { %><a href="<%= settings.socials.github %>" rel="noopener" target="_blank" aria-label="گیت‌هاب"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.4 9 18v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg></a><% } %>
          </div>
          <p class="tiny faint mt-2">معمولاً کمتر از ۱ روز کاری پاسخ می‌دهیم.</p>
        </div>
      </div>

      <div class="card card-pad-lg">
        <h2 class="h3 mb-3">فرم تماس</h2>
        <form method="POST" action="/contact">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="c-name">نام <span class="req">*</span></label>
              <input class="input <%= errors.name ? 'invalid' : '' %>" id="c-name" name="name" value="<%= values.name || '' %>" required>
              <% if (errors.name) { %><span class="form-error"><%= errors.name %></span><% } %>
            </div>
            <div class="form-group">
              <label class="form-label" for="c-phone">تلفن</label>
              <input class="input <%= errors.phone ? 'invalid' : '' %>" id="c-phone" name="phone" value="<%= values.phone || '' %>" inputmode="tel" placeholder="09121234567">
              <% if (errors.phone) { %><span class="form-error"><%= errors.phone %></span><% } %>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="c-email">ایمیل <span class="req">*</span></label>
            <input class="input <%= errors.email ? 'invalid' : '' %>" id="c-email" name="email" type="email" dir="ltr" style="text-align:left" value="<%= values.email || '' %>" required>
            <% if (errors.email) { %><span class="form-error"><%= errors.email %></span><% } %>
          </div>
          <div class="form-group">
            <label class="form-label" for="c-subject">موضوع</label>
            <input class="input" id="c-subject" name="subject" value="<%= values.subject || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label" for="c-body">پیام <span class="req">*</span></label>
            <textarea class="textarea <%= errors.body ? 'invalid' : '' %>" id="c-body" name="body" required><%= values.body || '' %></textarea>
            <% if (errors.body) { %><span class="form-error"><%= errors.body %></span><% } %>
          </div>
          <button class="btn btn-primary btn-lg" type="submit">ارسال پیام</button>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
