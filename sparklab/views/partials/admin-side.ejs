<%
  const sec = typeof adminSection !== 'undefined' ? adminSection : '';
  const sc = (typeof sideCounts !== 'undefined' && sideCounts) ? sideCounts : {};
%>
<aside class="admin-side">
  <div class="as-brand">
    <img src="/img/logo-icon.svg" alt="">
    <span>
      <b>SPARK<span style="color:var(--cyan)">LAB</span></b>
      <span>پنل مدیریت</span>
    </span>
  </div>
  <nav class="as-nav">
    <span class="as-group">اصلی</span>
    <a href="/admin" class="<%= sec === 'dashboard' ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
      پیشخوان
    </a>
    <a href="/admin/reports" class="<%= sec === 'reports' ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 15l4-6 3 4 5-8"/></svg>
      گزارش فروش
    </a>
    <span class="as-group">فروشگاه</span>
    <a href="/admin/products" class="<%= sec === 'products' ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/></svg>
      محصولات
    </a>
    <a href="/admin/categories" class="<%= sec === 'categories' ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7h-9M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg>
      دسته‌بندی‌ها
    </a>
    <a href="/admin/orders" class="<%= sec === 'orders' ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
      سفارش‌ها و تراکنش‌ها <% if (sc.pendingOrders) { %><span class="cnt"><%= sc.pendingOrders %><% } %></span>
    </a>
    <a href="/admin/coupons" class="<%= sec === 'coupons' ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2M13 17v2M13 11v2"/></svg>
      کدهای تخفیف
    </a>
    <span class="as-group">پروژه‌ها</span>
    <a href="/admin/projects" class="<%= sec === 'projects' ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      درخواست‌های پروژه <% if (sc.openProjects) { %><span class="cnt"><%= sc.openProjects %></span><% } %>
    </a>
    <span class="as-group">محتوا</span>
    <a href="/admin/content/pages" class="<%= sec === 'content' ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
      صفحات، نمونه‌کار و بنر
    </a>
    <a href="/admin/content/faqs" class="<%= sec === 'content' ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
      پرسش‌های متداول
    </a>
    <a href="/admin/content/messages" class="<%= sec === 'content' ? 'active' : '' %>">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></svg>
      پیام‌های تماس <% if (sc.unreadMessages) { %><span class="cnt"><%= sc.unreadMessages %></span><% } %>
    </a>
    <% if (isFullAdmin) { %>
      <span class="as-group">مدیریت</span>
      <a href="/admin/users" class="<%= sec === 'users' ? 'active' : '' %>">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        کاربران و نقش‌ها
      </a>
      <a href="/admin/settings" class="<%= sec === 'settings' ? 'active' : '' %>">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        تنظیمات سایت و درگاه
      </a>
      <a href="/admin/audit" class="<%= sec === 'audit' ? 'active' : '' %>">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
        رویدادهای امنیتی
      </a>
    <% } %>
  </nav>
  <div style="padding:.9rem;border-top:1px solid var(--border)">
    <a href="/" target="_blank" class="small" style="display:block;margin-bottom:.5rem">↗ مشاهده سایت</a>
    <form method="POST" action="/auth/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-danger btn-sm btn-block" type="submit">خروج (<%= currentUser.name %>)</button>
    </form>
  </div>
</aside>
