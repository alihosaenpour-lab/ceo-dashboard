<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <a class="brand" href="/">
          <img src="/img/logo-icon.svg" alt="<%= settings.name %>" style="width:40px">
          <span>
            <span class="brand-name">SPARK<span>LAB</span></span>
            <span class="brand-sub"><%= settings.name_fa %></span>
          </span>
        </a>
        <p><%= settings.tagline || settings.description %></p>
        <div class="social-row">
          <% if (settings.socials.instagram) { %><a href="<%= settings.socials.instagram %>" rel="noopener" aria-label="اینستاگرام" target="_blank"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg></a><% } %>
          <% if (settings.socials.telegram) { %><a href="<%= settings.socials.telegram %>" rel="noopener" aria-label="تلگرام" target="_blank"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg></a><% } %>
          <% if (settings.socials.linkedin) { %><a href="<%= settings.socials.linkedin %>" rel="noopener" aria-label="لینکدین" target="_blank"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-13h4v2a6 6 0 0 1 2-2z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg></a><% } %>
          <% if (settings.socials.github) { %><a href="<%= settings.socials.github %>" rel="noopener" aria-label="گیت‌هاب" target="_blank"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.4 9 18v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg></a><% } %>
          <% if (settings.socials.x) { %><a href="<%= settings.socials.x %>" rel="noopener" aria-label="ایکس" target="_blank"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L1.6 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L7.1 3.9H5.3L17.8 20Z"/></svg></a><% } %>
        </div>
      </div>
      <div>
        <h4>دسترسی سریع</h4>
        <div class="footer-links">
          <a href="/shop">فروشگاه محصولات</a>
          <a href="/services">خدمات اختصاصی</a>
          <a href="/portfolio">نمونه‌کارها</a>
          <a href="/projects/new">ثبت سفارش پروژه</a>
          <a href="/faq">پرسش‌های متداول</a>
        </div>
      </div>
      <div>
        <h4>قوانین و راهنما</h4>
        <div class="footer-links">
          <% if (typeof footerPages !== 'undefined') { footerPages.forEach(function (p) { %>
            <a href="/p/<%= p.slug %>"><%= p.title %></a>
          <% }); } %>
        </div>
      </div>
      <div>
        <h4>تماس با ما</h4>
        <div class="footer-contact">
          <% if (settings.phone) { %>
          <div class="fc-row">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span style="direction:ltr"><%= settings.phone %></span>
          </div>
          <% } %>
          <% if (settings.email) { %>
          <div class="fc-row">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span><%= settings.email %></span>
          </div>
          <% } %>
          <% if (settings.address) { %>
          <div class="fc-row">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
            <span><%= settings.address %></span>
          </div>
          <% } %>
          <% if (settings.workhours) { %>
          <div class="fc-row">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span><%= settings.workhours %></span>
          </div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="flex" style="gap:1rem">
        <span>© <%= new Date().toLocaleDateString('fa-IR', { year: 'numeric' }) %> <%= settings.name_fa %> — تمامی حقوق محفوظ است.</span>
        <% if (settings.enamad) { %><span class="flex"><%- h.sanitizeRich(settings.enamad) %></span><% } %>
      </span>
      <span class="flex" style="gap:.4rem">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        پرداخت امن با درگاه معتبر بانکی — فایل‌ها با لینک امن و زمان‌دار تحویل می‌شوند
      </span>
    </div>
  </div>
</footer>
<script nonce="<%= cspNonce %>">window.SPARK_CSRF = <%- JSON.stringify(csrfToken) %>;</script>
<script src="/js/main.js" defer></script>
</body>
</html>
