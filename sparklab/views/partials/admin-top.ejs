<div class="admin-top">
  <div class="flex">
    <button class="icon-btn admin-side-toggle" aria-label="منوی مدیریت">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <h1><%= typeof title !== 'undefined' ? title.replace(' | اسپارک لب', '') : 'پنل مدیریت' %></h1>
  </div>
  <div class="flex">
    <% if (gateway.test) { %><span class="status warn">درگاه: آزمایشی</span>
    <% } else if (gateway.connected) { %><span class="status ok">درگاه: <%= gateway.label %></span>
    <% } else { %><span class="status bad">درگاه: متصل نیست</span><% } %>
    <span class="pill pill-cyan" style="text-transform:uppercase"><%= currentUser.role %></span>
  </div>
</div>
