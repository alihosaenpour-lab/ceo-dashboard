<% if (flash) { %>
<div class="flash-wrap">
  <div class="flash <%= flash.type %>" data-autohide role="alert">
    <% if (flash.type === 'ok') { %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>
    <% } else { %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    <% } %>
    <span><%= flash.text %></span>
  </div>
</div>
<% } %>
