<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container">
  <div class="panel-layout">
    <%- include('../partials/account-side') %>
    <main class="panel-main">
      <div class="panel-title"><h1>تنظیمات حساب</h1></div>
      <div class="grid grid-2" style="align-items:start">
        <div class="card">
          <h2 class="h3 mb-3">اطلاعات حساب</h2>
          <form method="POST" action="/account/profile">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group">
              <label class="form-label" for="pf-name">نام و نام خانوادگی</label>
              <input class="input <%= errors.name ? 'invalid' : '' %>" id="pf-name" name="name" value="<%= values.name || '' %>" required>
              <% if (errors.name) { %><span class="form-error"><%= errors.name %></span><% } %>
            </div>
            <div class="form-group">
              <label class="form-label">ایمیل</label>
              <input class="input" value="<%= profile.email %>" disabled dir="ltr" style="text-align:left">
              <span class="form-hint">ایمیل حساب قابل تغییر نیست؛ برای تغییر با پشتیبانی تماس بگیرید.</span>
            </div>
            <div class="form-group">
              <label class="form-label" for="pf-phone">شماره موبایل</label>
              <input class="input <%= errors.phone ? 'invalid' : '' %>" id="pf-phone" name="phone" value="<%= values.phone || '' %>" inputmode="tel" placeholder="09121234567">
              <% if (errors.phone) { %><span class="form-error"><%= errors.phone %></span><% } %>
            </div>
            <button class="btn btn-primary" type="submit">ذخیره تغییرات</button>
          </form>
        </div>
        <div class="card">
          <h2 class="h3 mb-3">تغییر رمز عبور</h2>
          <form method="POST" action="/account/password">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group">
              <label class="form-label" for="pf-cur">رمز عبور فعلی</label>
              <input class="input" id="pf-cur" name="current_password" type="password" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="pf-new">رمز عبور جدید</label>
              <input class="input" id="pf-new" name="password" type="password" minlength="8" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="pf-new2">تکرار رمز جدید</label>
              <input class="input" id="pf-new2" name="password2" type="password" minlength="8" required>
            </div>
            <button class="btn btn-primary" type="submit">تغییر رمز عبور</button>
          </form>
          <hr class="divider">
          <p class="tiny faint">عضو از: <%= h.fmtDate(profile.created_at, { time: false }) %></p>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
