<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container">
  <div class="panel-layout">
    <%- include('../partials/account-side') %>
    <main class="panel-main">
      <div class="panel-title">
        <h1 class="flex" style="gap:.8rem;flex-wrap:wrap">سفارش <span style="direction:ltr"><%= order.order_no %></span>
          <span class="status <%= h.statusClass(order.status) %>"><%= h.statusLabel(order.status) %></span>
        </h1>
        <a class="btn btn-ghost btn-sm no-print" href="/account/orders/<%= order.order_no %>/invoice">🧾 رسید / فاکتور</a>
      </div>

      <% if (order.status === 'paid' && grants.length) { %>
        <div class="card mb-3" style="border-color:rgba(52,211,153,.35)">
          <h2 class="h3 mb-2" style="color:var(--ok)">✓ پرداخت تأیید شده — فایل‌های شما آماده است</h2>
          <% grants.forEach(function (g) { %>
            <div class="flex-between wrap" style="padding:.8rem 0;border-bottom:1px dashed var(--border);gap:.6rem">
              <div>
                <b><%= g.product_title %></b>
                <div class="tiny faint">فایل: <%= g.original_name %> — نسخه <%= g.version %>
                  <% if (g.expires_at) { %> — انقضا لینک: <%= h.fmtDate(g.expires_at) %><% } %>
                  <% if (g.max_downloads) { %> — دانلودهای باقیمانده: <%= h.fmtMoney(g.max_downloads - g.downloads_count) %><% } %>
                </div>
              </div>
              <a class="btn btn-primary btn-sm" href="/download/<%= g.token %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                دانلود فایل
              </a>
            </div>
          <% }); %>
          <p class="tiny faint mt-2">لینک دانلود امن، زمان‌دار و محدود به حساب شماست. در صورت انقضا از <a href="/account/downloads">بخش دانلودها</a> لینک تازه بگیرید.</p>
        </div>
      <% } else if (order.status === 'failed') { %>
        <div class="alert bad mb-3"><span>پرداخت این سفارش تأیید نشد؛ هیچ فایلی تحویل داده نمی‌شود و مبلغی از حساب شما کسر نگردیده (یا طبق روال بانک بازمی‌گردد). برای تلاش مجدد، محصولات را دوباره به سبد اضافه کنید.</span></div>
      <% } else if (order.status === 'pending') { %>
        <div class="alert warn mb-3"><span>این سفارش هنوز پرداخت نشده است. تا تأیید پرداخت توسط درگاه، فایل‌ها تحویل داده نمی‌شوند.</span></div>
      <% } %>

      <div class="card mb-3">
        <h2 class="h3 mb-2">اقلام سفارش</h2>
        <% order.items.forEach(function (it) { %>
          <div class="flex-between wrap" style="padding:.7rem 0;border-bottom:1px dashed var(--border);gap:.5rem">
            <div>
              <a href="/product/<%= it.slug %>" style="font-weight:700"><%= it.title %></a>
              <div class="tiny faint">نسخه <span style="direction:ltr;display:inline-block"><%= it.version %></span> · تعداد <%= h.fmtMoney(it.qty) %> · قیمت واحد <%= h.fmtMoney(it.unit_price) %> <%= order.currency %></div>
            </div>
            <b class="num"><%= h.fmtMoney(it.line_total) %> <%= order.currency %></b>
          </div>
        <% }); %>
        <div class="mt-2" style="max-width:320px;margin-inline-start:auto">
          <div class="summary-row"><span>جمع کل</span><span class="num"><%= h.fmtMoney(order.subtotal) %></span></div>
          <% if (order.discount_total > 0) { %><div class="summary-row"><span>تخفیف <%= order.coupon_code ? '(' + order.coupon_code + ')' : '' %></span><span class="green num">− <%= h.fmtMoney(order.discount_total) %></span></div><% } %>
          <div class="summary-row total"><span>مبلغ پرداختی</span><span class="num"><%= h.fmtMoney(order.total) %> <%= order.currency %></span></div>
        </div>
      </div>

      <div class="card">
        <h2 class="h3 mb-2">اطلاعات سفارش و پرداخت</h2>
        <dl class="kv">
          <dt>تاریخ ثبت</dt><dd><%= h.fmtDate(order.created_at) %></dd>
          <% if (order.paid_at) { %><dt>تاریخ پرداخت</dt><dd><%= h.fmtDate(order.paid_at) %></dd><% } %>
          <% if (order.gateway) { %><dt>درگاه پرداخت</dt><dd><%= order.gateway === 'zarinpal' ? 'زرین‌پال' : (order.gateway === 'test' ? 'درگاه آزمایشی (تست)' : order.gateway) %></dd><% } %>
          <% if (order.payment_ref) { %><dt>شناسه تراکنش</dt><dd style="direction:ltr;text-align:right"><%= order.payment_ref %></dd><% } %>
          <dt>خریدار</dt><dd><%= order.buyer_name %> — <span style="direction:ltr;display:inline-block"><%= order.buyer_phone || '—' %></span> — <%= order.buyer_email %></dd>
          <dt>شماره فاکتور</dt><dd style="direction:ltr;text-align:right"><%= order.invoice_no %></dd>
        </dl>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
