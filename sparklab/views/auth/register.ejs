<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section">
  <div class="container" style="max-width:480px">
    <div class="card card-pad-lg">
      <div class="text-center mb-3">
        <img src="/img/logo-icon.svg" alt="" style="width:52px;margin:0 auto">
        <h1 class="h2 mt-2">ایجاد حساب کاربری</h1>
        <p class="muted small">در چند ثانیه حساب بسازید و خرید کنید.</p>
      </div>
      <form method="POST" action="/auth/register">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label class="form-label" for="r-name">نام و نام خانوادگی</label>
          <input class="input <%= errors.name ? 'invalid' : '' %>" id="r-name" name="name" value="<%= values.name || '' %>" required autofocus>
          <% if (errors.name) { %><span class="form-error"><%= errors.name %></span><% } %>
        </div>
        <div class="form-group">
          <label class="form-label" for="r-email">ایمیل</label>
          <input class="input <%= errors.email ? 'invalid' : '' %>" id="r-email" name="email" type="email" dir="ltr" style="text-align:left" value="<%= values.email || '' %>" required>
          <% if (errors.email) { %><span class="form-error"><%= errors.email %></span><% } %>
        </div>
        <div class="form-group">
          <label class="form-label" for="r-phone">شماره موبایل</label>
          <input class="input <%= errors.phone ? 'invalid' : '' %>" id="r-phone" name="phone" value="<%= values.phone || '' %>" placeholder="09121234567" inputmode="tel" required>
          <% if (errors.phone) { %><span class="form-error"><%= errors.phone %></span><% } %>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="r-pass">رمز عبور</label>
            <input class="input <%= errors.password ? 'invalid' : '' %>" id="r-pass" name="password" type="password" minlength="8" required>
            <span class="form-hint">حداقل ۸ نویسه</span>
            <% if (errors.password) { %><span class="form-error"><%= errors.password %></span><% } %>
          </div>
          <div class="form-group">
            <label class="form-label" for="r-pass2">تکرار رمز عبور</label>
            <input class="input <%= errors.password2 ? 'invalid' : '' %>" id="r-pass2" name="password2" type="password" minlength="8" required>
            <% if (errors.password2) { %><span class="form-error"><%= errors.password2 %></span><% } %>
          </div>
        </div>
        <div class="check-row">
          <input type="checkbox" id="r-accept" name="accept_terms" value="1" required>
          <label for="r-accept"><a href="/p/terms" target="_blank">قوانین استفاده</a> و <a href="/p/privacy" target="_blank">حریم خصوصی</a> را می‌پذیرم.</label>
        </div>
        <% if (errors.accept_terms) { %><span class="form-error"><%= errors.accept_terms %></span><% } %>
        <button class="btn btn-primary btn-lg btn-block mt-3" type="submit">ایجاد حساب</button>
      </form>
      <hr class="divider">
      <p class="small muted text-center">حساب دارید؟ <a href="/auth/login">وارد شوید</a></p>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
