<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section">
  <div class="container" style="max-width:460px">
    <div class="card card-pad-lg">
      <h1 class="h2 mb-1">بازنشانی رمز عبور</h1>
      <p class="muted small mb-3">رمز عبور جدید را وارد کنید.</p>
      <% if (errors.token) { %>
        <div class="alert bad mb-3"><span><%= errors.token %></span></div>
        <a class="btn btn-ghost btn-block" href="/auth/forgot">درخواست لینک جدید</a>
      <% } else { %>
        <form method="POST" action="/auth/reset/<%= token %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label class="form-label" for="n-pass">رمز عبور جدید</label>
            <input class="input <%= errors.password ? 'invalid' : '' %>" id="n-pass" name="password" type="password" minlength="8" required autofocus>
            <span class="form-hint">حداقل ۸ نویسه</span>
            <% if (errors.password) { %><span class="form-error"><%= errors.password %></span><% } %>
          </div>
          <div class="form-group">
            <label class="form-label" for="n-pass2">تکرار رمز جدید</label>
            <input class="input <%= errors.password2 ? 'invalid' : '' %>" id="n-pass2" name="password2" type="password" minlength="8" required>
            <% if (errors.password2) { %><span class="form-error"><%= errors.password2 %></span><% } %>
          </div>
          <button class="btn btn-primary btn-lg btn-block" type="submit">ذخیره رمز جدید</button>
        </form>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
